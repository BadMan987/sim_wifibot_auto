<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Wifibot Lab V4 chassis parameters -->
  <xacro:property name="base_length" value="0.32"/>
  <xacro:property name="base_width"  value="0.37"/>
  <xacro:property name="base_height" value="0.15"/>
  <xacro:property name="base_mass"   value="3.8"/>

  <!-- Approximate wheel parameters, tune later with real measurement -->
  <xacro:property name="wheel_radius" value="0.075"/>
  <xacro:property name="wheel_width"  value="0.045"/>
  <xacro:property name="wheel_mass"   value="0.25"/>

  <xacro:property name="front_wheel_x" value="0.105"/>
  <xacro:property name="rear_wheel_x"  value="-0.105"/>
  <xacro:property name="left_wheel_y"  value="0.185"/>
  <xacro:property name="right_wheel_y" value="-0.185"/>
  <xacro:property name="wheel_z"       value="0.075"/>

  <!-- Inertia helper for box -->
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${mass / 12.0 * (y*y + z*z)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass / 12.0 * (x*x + z*z)}"
        iyz="0.0"
        izz="${mass / 12.0 * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- Inertia helper for wheel cylinder, axis along Y -->
  <xacro:macro name="wheel_inertia" params="mass radius width">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${mass * (3.0*radius*radius + width*width) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * radius*radius / 2.0}"
        iyz="0.0"
        izz="${mass * (3.0*radius*radius + width*width) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Ground projection frame -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/>
  </joint>

  <!-- Main chassis body -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="wifibot_dark_gray">
        <color rgba="0.10 0.10 0.10 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertia
      mass="${base_mass}"
      x="${base_length}"
      y="${base_width}"
      z="${base_height}"/>
  </link>

  <!-- Simple top support plate -->
  <link name="top_plate_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.30 0.015"/>
      </geometry>
      <material name="wifibot_silver">
        <color rgba="0.70 0.70 0.70 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.30 0.015"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="0.003"
        ixy="0.0"
        ixz="0.0"
        iyy="0.003"
        iyz="0.0"
        izz="0.004"/>
    </inertial>
  </link>

  <joint name="top_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_plate_link"/>
    <origin xyz="0 0 ${base_height / 2.0 + 0.015}" rpy="0 0 0"/>
  </joint>

  <!-- Wheel macro -->
  <xacro:macro name="wifibot_wheel" params="name x y">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wifibot_black">
          <color rgba="0.02 0.02 0.02 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <xacro:wheel_inertia
        mass="${wheel_mass}"
        radius="${wheel_radius}"
        width="${wheel_width}"/>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${-base_height / 2.0 + wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Four wheels -->
  <xacro:wifibot_wheel name="front_left_wheel"  x="${front_wheel_x}" y="${left_wheel_y}"/>
  <xacro:wifibot_wheel name="rear_left_wheel"   x="${rear_wheel_x}"  y="${left_wheel_y}"/>
  <xacro:wifibot_wheel name="front_right_wheel" x="${front_wheel_x}" y="${right_wheel_y}"/>
  <xacro:wifibot_wheel name="rear_right_wheel"  x="${rear_wheel_x}"  y="${right_wheel_y}"/>



<!-- ========================= -->
<!-- Gazebo differential drive -->
<!-- ========================= -->
<gazebo>
  <plugin name="wifibot_diff_drive" filename="libgazebo_ros_diff_drive.so">

    <ros>
      <namespace>/</namespace>
    </ros>

    <update_rate>50</update_rate>

    <!-- Drive joints: first version uses front wheels -->
    <left_joint>front_left_wheel_joint</left_joint>
    <right_joint>front_right_wheel_joint</right_joint>

    <!-- Kinematics -->
    <wheel_separation>0.37</wheel_separation>
    <wheel_diameter>0.15</wheel_diameter>

    <!-- Limits -->
    <max_wheel_torque>20.0</max_wheel_torque>
    <max_wheel_acceleration>2.0</max_wheel_acceleration>

    <!-- ROS interfaces -->
    <command_topic>cmd_vel</command_topic>
    <odometry_topic>odom</odometry_topic>

    <!-- Frames -->
    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_footprint</robot_base_frame>

    <!-- Publish options -->
    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
    <publish_wheel_tf>true</publish_wheel_tf>

  </plugin>
</gazebo>

</robot>
