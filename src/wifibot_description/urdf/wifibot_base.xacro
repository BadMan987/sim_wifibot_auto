<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Châssis Wifibot Lab V4 -->
  <xacro:property name="base_length" value="0.32"/>
  <xacro:property name="base_width" value="0.37"/>
  <xacro:property name="base_height" value="0.15"/>
  <xacro:property name="wheel_radius" value="0.069"/>
  <xacro:property name="wheel_width" value="0.055"/>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.069" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="0.24 0.22 0.12"/></geometry>
      <material name="wifibot_dark_gray"><color rgba="0.10 0.10 0.10 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.24 0.22 0.12"/></geometry></collision>
    <inertial>
      <mass value="3.8"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0505" ixy="0" ixz="0" iyy="0.0394" iyz="0" izz="0.0757"/>
    </inertial>
  </link>

  <link name="top_plate_link">
    <visual>
      <geometry><box size="0.28 0.30 0.015"/></geometry>
      <material name="wifibot_silver"><color rgba="0.70 0.70 0.70 1.0"/></material>
    </visual>
    <collision><geometry><box size="0.28 0.30 0.015"/></geometry></collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.004"/>
    </inertial>
  </link>

  <joint name="top_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_plate_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
</joint>

  <xacro:macro name="wheel" params="prefix x y">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wifibot_black"><color rgba="1 0 0 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.25"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00037" ixy="0" ixz="0" iyy="0.00070" iyz="0" izz="0.00037"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} ${-wheel_radius}"
        rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

<xacro:wheel prefix="front_left"
             x="0.09"
             y="0.15"/>

<xacro:wheel prefix="rear_left"
             x="-0.09"
             y="0.15"/>

<xacro:wheel prefix="front_right"
             x="0.09"
             y="-0.15"/>

<xacro:wheel prefix="rear_right"
             x="-0.09"
             y="-0.15"/>

  <gazebo reference="front_left_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="rear_left_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="front_right_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="rear_right_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>

  <gazebo>
  <plugin name="wifibot_four_wheel_diff_drive"
          filename="libgazebo_ros_diff_drive.so">

    <ros>
      <namespace>/</namespace>
    </ros>

    <update_rate>50</update_rate>

    <!-- Deux paires de roues -->
    <num_wheel_pairs>2</num_wheel_pairs>

    <!-- Première paire : roues avant, Deuxième paire : roues arrière -->
    <left_joint>front_left_wheel_joint</left_joint>
    <left_joint>rear_left_wheel_joint</left_joint>

    <right_joint>front_right_wheel_joint</right_joint>
    <right_joint>rear_right_wheel_joint</right_joint>

    <!-- Chaque paire de roues doit correspondre à un paramètre -->
    <wheel_separation>0.30</wheel_separation>
    <wheel_separation>0.30</wheel_separation>

    <wheel_diameter>0.138</wheel_diameter>
    <wheel_diameter>0.138</wheel_diameter>

    <max_wheel_torque>20.0</max_wheel_torque>
    <max_wheel_acceleration>2.0</max_wheel_acceleration>

    <command_topic>cmd_vel</command_topic>
    <odometry_topic>odom</odometry_topic>
    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_footprint</robot_base_frame>

    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
    <publish_wheel_tf>true</publish_wheel_tf>

  </plugin>
</gazebo>

</robot>
