<?xml version="1.0"?>
<sdf version="1.6">
  <world name="wifibot_indoor_world">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.75 0.82 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Helper convention: wall pose is x y z roll pitch yaw -->
    <!-- Outer boundary: 8 m x 6 m, wall thickness 0.10 m, height 2 m -->

    <model name="outer_wall_north">
      <static>true</static><pose>0 3 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.1 0.1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.1 0.1 2</size></box></geometry><material><ambient>0.80 0.80 0.78 1</ambient><diffuse>0.80 0.80 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="outer_wall_south">
      <static>true</static><pose>0 -3 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.1 0.1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.1 0.1 2</size></box></geometry><material><ambient>0.80 0.80 0.78 1</ambient><diffuse>0.80 0.80 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="outer_wall_west">
      <static>true</static><pose>-4 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 6.1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 6.1 2</size></box></geometry><material><ambient>0.80 0.80 0.78 1</ambient><diffuse>0.80 0.80 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="outer_wall_east">
      <static>true</static><pose>4 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 6.1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 6.1 2</size></box></geometry><material><ambient>0.80 0.80 0.78 1</ambient><diffuse>0.80 0.80 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Main corridor: x direction, from x=-4 to x=4, width 1.2 m -->
    <!-- North corridor wall has two 1 m door openings centered at x=-2 and x=2 -->

    <model name="north_corridor_wall_left">
      <static>true</static><pose>-3.25 0.6 1 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.5 0.1 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.5 0.1 2</size></box></geometry><material><ambient>0.65 0.72 0.80 1</ambient><diffuse>0.65 0.72 0.80 1</diffuse></material></visual></link>
    </model>

    <model name="north_corridor_wall_center">
      <static>true</static><pose>0 0.6 1 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>3.0 0.1 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>3.0 0.1 2</size></box></geometry><material><ambient>0.65 0.72 0.80 1</ambient><diffuse>0.65 0.72 0.80 1</diffuse></material></visual></link>
    </model>

    <model name="north_corridor_wall_right">
      <static>true</static><pose>3.25 0.6 1 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.5 0.1 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.5 0.1 2</size></box></geometry><material><ambient>0.65 0.72 0.80 1</ambient><diffuse>0.65 0.72 0.80 1</diffuse></material></visual></link>
    </model>

    <!-- South corridor boundary with a 2 m open entrance to room 3 -->
    <model name="south_corridor_wall_left">
      <static>true</static><pose>-2.5 -0.6 1 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>3.0 0.1 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>3.0 0.1 2</size></box></geometry><material><ambient>0.72 0.68 0.58 1</ambient><diffuse>0.72 0.68 0.58 1</diffuse></material></visual></link>
    </model>

    <model name="south_corridor_wall_right">
      <static>true</static><pose>2.5 -0.6 1 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>3.0 0.1 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>3.0 0.1 2</size></box></geometry><material><ambient>0.72 0.68 0.58 1</ambient><diffuse>0.72 0.68 0.58 1</diffuse></material></visual></link>
    </model>

    <!-- Partition between room 1 and room 2 -->
    <model name="north_room_partition">
      <static>true</static><pose>0 1.8 1 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.1 2.4 2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 2.4 2</size></box></geometry><material><ambient>0.76 0.70 0.82 1</ambient><diffuse>0.76 0.70 0.82 1</diffuse></material></visual></link>
    </model>

    <!-- Door headers visually mark two 1 m-wide openings -->
    <model name="door_header_room1">
      <static>true</static><pose>-2 0.6 1.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.0 0.12 0.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.0 0.12 0.2</size></box></geometry><material><ambient>0.25 0.16 0.08 1</ambient><diffuse>0.25 0.16 0.08 1</diffuse></material></visual></link>
    </model>

    <model name="door_header_room2">
      <static>true</static><pose>2 0.6 1.9 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.0 0.12 0.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.0 0.12 0.2</size></box></geometry><material><ambient>0.25 0.16 0.08 1</ambient><diffuse>0.25 0.16 0.08 1</diffuse></material></visual></link>
    </model>

    <!-- Six colorful static objects for visual SLAM features -->
    <model name="red_cabinet">
      <static>true</static><pose>-3.1 2.2 0.6 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.6 0.4 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.6 0.4 1.2</size></box></geometry><material><ambient>0.85 0.10 0.10 1</ambient><diffuse>0.85 0.10 0.10 1</diffuse></material></visual></link>
    </model>

    <model name="blue_table">
      <static>true</static><pose>-1.3 1.7 0.4 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.0 0.7 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.0 0.7 0.8</size></box></geometry><material><ambient>0.10 0.25 0.85 1</ambient><diffuse>0.10 0.25 0.85 1</diffuse></material></visual></link>
    </model>

    <model name="green_cabinet">
      <static>true</static><pose>3.1 2.2 0.6 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.6 0.4 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.6 0.4 1.2</size></box></geometry><material><ambient>0.10 0.75 0.20 1</ambient><diffuse>0.10 0.75 0.20 1</diffuse></material></visual></link>
    </model>

    <model name="yellow_table">
      <static>true</static><pose>1.3 1.7 0.4 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.0 0.7 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.0 0.7 0.8</size></box></geometry><material><ambient>0.90 0.75 0.08 1</ambient><diffuse>0.90 0.75 0.08 1</diffuse></material></visual></link>
    </model>

    <model name="purple_box">
      <static>true</static><pose>-2.2 -1.8 0.35 0 0 0.35</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.7 0.7 0.7</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.7 0.7 0.7</size></box></geometry><material><ambient>0.65 0.15 0.75 1</ambient><diffuse>0.65 0.15 0.75 1</diffuse></material></visual></link>
    </model>

    <model name="orange_cylinder">
      <static>true</static><pose>2.2 -1.8 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.40 0.05 1</diffuse></material></visual></link>
    </model>

  </world>
</sdf>
